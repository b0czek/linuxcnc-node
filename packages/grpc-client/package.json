{
  "name": "@linuxcnc-node/grpc-client",
  "version": "1.0.0",
  "description": "Raw generated TypeScript contract for linuxcnc.v1 gRPC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "proto/",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node scripts/bundle-proto.mjs && node scripts/generate-grpc.mjs",
    "build": "tsc",
    "check:generated": "node ../types/scripts/check-generated.mjs && node scripts/check-generated.mjs",
    "test:conformance": "pnpm run build && node --test test/*.test.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@linuxcnc-node/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/b0czek/linuxcnc-node.git",
    "directory": "packages/grpc-client"
  }
}
