{
  "name": "@linuxcnc-node/gcode",
  "version": "3.2.1",
  "description": "Node.js G-code parser using LinuxCNC rs274ngc interpreter",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build:ts": "tsc",
    "build:cpp": "node-gyp configure && node-gyp build",
    "build": "pnpm run build:cpp && pnpm run build:ts",
    "rebuild": "node-gyp rebuild",
    "install": "node-gyp configure && node-gyp build",
    "prepublishOnly": "pnpm run build",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --testPathPatterns=tests/integration",
    "test:coverage": "jest --coverage --runInBand"
  },
  "author": "Dariusz Majnert",
  "repository": {
    "type": "git",
    "url": "https://github.com/b0czek/linuxcnc-node.git",
    "directory": "packages/gcode"
  },
  "license": "GPL-2.0-only",
  "dependencies": {
    "@linuxcnc-node/types": "workspace:*",
    "node-addon-api": "catalog:",
    "node-gyp": "catalog:"
  },
  "devDependencies": {
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "dist/",
    "src/cpp",
    "binding.gyp",
    "README.md"
  ],
  "gypfile": true,
  "os": [
    "linux"
  ],
  "keywords": [
    "linuxcnc",
    "gcode",
    "cnc",
    "parser",
    "rs274ngc",
    "interpreter",
    "machining",
    "cam",
    "native",
    "addon",
    "bindings"
  ]
}
