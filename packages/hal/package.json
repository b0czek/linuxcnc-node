{
  "name": "@linuxcnc-node/hal",
  "version": "4.0.0",
  "description": "Node.js bindings for LinuxCNC HAL library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build:ts": "tsc",
    "build:cpp": "node-gyp configure && node-gyp build",
    "build": "pnpm run build:cpp && pnpm run build:ts",
    "rebuild": "node-gyp rebuild",
    "install": "node-gyp configure && node-gyp build",
    "prepublishOnly": "pnpm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "author": "Dariusz Majnert",
  "repository": {
    "type": "git",
    "url": "https://github.com/b0czek/linuxcnc-node.git",
    "directory": "packages/hal"
  },
  "license": "GPL-2.0-only",
  "dependencies": {
    "@linuxcnc-node/types": "workspace:*",
    "node-addon-api": "catalog:",
    "node-gyp": "catalog:"
  },
  "devDependencies": {
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "dist/",
    "src/cpp",
    "binding.gyp",
    "README.md"
  ],
  "gypfile": true,
  "os": [
    "linux"
  ],
  "keywords": [
    "linuxcnc",
    "hal",
    "cnc",
    "hardware abstraction layer",
    "machining",
    "automation",
    "robotics",
    "motion control",
    "native",
    "addon",
    "bindings",
    "manufacturing",
    "industrial"
  ]
}
