{
  "name": "@linuxcnc-node/websocket-client",
  "version": "1.0.0",
  "description": "Browser WebSocket client for the linuxcnc.v1 protobuf data plane",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node scripts/generate.mjs",
    "build": "tsc",
    "check:generated": "node scripts/check-generated.mjs",
    "test": "pnpm run build && node --test test/*.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@linuxcnc-node/types": "workspace:*"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/b0czek/linuxcnc-node.git",
    "directory": "packages/websocket-client"
  }
