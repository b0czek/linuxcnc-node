{
  "name": "@linuxcnc-node/core",
  "version": "3.2.1",
  "description": "Node.js bindings for core LinuxCNC NML interface",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build:ts": "tsc",
    "build:cpp": "node-gyp configure && node-gyp build",
    "build": "pnpm run build:cpp && pnpm run build:ts",
    "rebuild": "node-gyp rebuild",
    "install": "node-gyp configure && node-gyp build",
    "prepublishOnly": "pnpm run build",
    "test": "jest --runInBand",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "test:unit": "jest --runInBand --testPathPatterns=tests/unit",
    "test:integration": "jest --runInBand --testPathPatterns=tests/integration",
    "test:all": "pnpm run test:unit && pnpm run test:integration",
    "test:coverage": "jest --coverage --runInBand",
    "docs": "typedoc"
  },
  "author": "Dariusz Majnert",
  "repository": {
    "type": "git",
    "url": "https://github.com/b0czek/linuxcnc-node.git",
    "directory": "packages/core"
  },
  "license": "GPL-2.0-only",
  "dependencies": {
    "@linuxcnc-node/types": "workspace:*",
    "dlv": "catalog:",
    "dset": "catalog:",
    "node-addon-api": "catalog:",
    "node-gyp": "catalog:"
  },
  "devDependencies": {
    "@types/dlv": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "dist/",
    "src/cpp",
    "scripts/",
    "binding.gyp",
    "README.md"
  ],
  "gypfile": true,
  "os": [
    "linux"
  ],
  "keywords": [
    "linuxcnc",
    "hal",
    "cnc",
    "hardware abstraction layer",
    "machining",
    "automation",
    "robotics",
    "motion control",
    "native",
    "addon",
    "bindings",
    "manufacturing",
    "industrial"
  ]
}
