{
  "name": "@linuxcnc-node/hal-inspector",
  "version": "4.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/b0czek/linuxcnc-node.git",
    "directory": "apps/eden/hal-inspector"
  },
  "type": "module",
  "main": "backend/dist/backend.cjs",
  "scripts": {
    "dev": "vite --config frontend/vite.config.mts",
    "dev:eden": "eden-build dev",
    "build:frontend": "vite build --config frontend/vite.config.mts",
    "build:backend": "tsup --config backend/tsup.config.ts",
    "build:proto": "node scripts/copy-proto.cjs",
    "build": "npm run build:backend && npm run build:proto && npm run build:frontend",
    "test:proto": "node scripts/test-proto.cjs",
    "test:mappings": "node scripts/test-mappings.cjs",
    "test": "npm run build:proto && npm run test:proto && npm run test:mappings",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build && genesis build . -o hal-inspector.edenite"
  },
  "dependencies": {
    "@edenapp/babel": "catalog:",
    "@edenapp/types": "catalog:",
    "@grpc/grpc-js": "^1.14.0",
    "@kobalte/core": "^0.13.11",
    "@linuxcnc-node/grpc-client": "workspace:*",
    "@linuxcnc-node/websocket-client": "workspace:*",
    "@linuxcnc-node/types": "workspace:*",
    "@tanstack/solid-virtual": "^3.13.37",
    "solid-icons": "^1.1.0",
    "solid-js": "^1.9.10",
    "webgl-plot": "^1.1.2"
  },
  "devDependencies": {
    "@edenapp/genesis": "catalog:",
    "@edenapp/scripts": "catalog:",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0",
    "vite": "^7.2.4",
    "vite-plugin-solid": "^2.11.10"
  }
}
