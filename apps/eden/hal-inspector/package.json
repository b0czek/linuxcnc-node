{
  "name": "@linuxcnc-node/hal-inspector",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "backend/dist/backend.cjs",
  "scripts": {
    "dev": "vite --config frontend/vite.config.mts",
    "dev:eden": "eden-build dev",
    "copy-addons": "node scripts/copy-addons.cjs",
    "build:frontend": "vite build --config frontend/vite.config.mts",
    "build:backend": "tsup --config backend/tsup.config.ts",
    "build": "npm run copy-addons && npm run build:backend && npm run build:frontend",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build && genesis build . -o hal-inspector.edenite"
  },
  "dependencies": {
    "@edenapp/babel": "catalog:",
    "@edenapp/types": "catalog:",
    "@kobalte/core": "^0.13.11",
    "@linuxcnc-node/hal": "workspace:*",
    "@linuxcnc-node/types": "workspace:*",
    "@tanstack/solid-virtual": "^3.13.12",
    "solid-icons": "^1.1.0",
    "solid-js": "^1.9.10",
    "webgl-plot": "^1.1.2"
  },
  "devDependencies": {
    "@edenapp/genesis": "catalog:",
    "@edenapp/scripts": "catalog:",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0",
    "vite": "^7.2.4",
    "vite-plugin-solid": "^2.11.10"
  }
}
